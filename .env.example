# Optional explicit canonical origin. Set after the production domain is confirmed.
# Vercel normally supplies VERCEL_PROJECT_PRODUCTION_URL automatically.
# Local development falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional future CMS; not needed to run or deploy the current portfolio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never expose service-role keys, GitHub tokens, or Vercel tokens in NEXT_PUBLIC_*.
